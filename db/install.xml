<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/assignmentnotice/db" VERSION="20240126" COMMENT="XMLDB file for local_assignmentnotice"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_assignmentnotice" COMMENT="Stores AI Assessment Scale settings per assignment">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="assignmentid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Foreign key to assign.id"/>
        <FIELD NAME="aiaslevel" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="AI Assessment Scale level (0=none, 1-5=levels)"/>
        <FIELD NAME="bannertype" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="info" SEQUENCE="false" COMMENT="Bootstrap alert type"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="assignmentid" TYPE="foreign-unique" FIELDS="assignmentid" REFTABLE="assign" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="assignmentid_idx" UNIQUE="true" FIELDS="assignmentid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
