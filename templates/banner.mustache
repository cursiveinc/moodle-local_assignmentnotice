{{!
    @template local_assignmentnotice/banner

    AI Assessment Scale banner template.

    Classes required for JS:
    * local-assignmentnotice-container - Container for banner positioning

    Data attributes required for JS:
    * None

    Context variables required for this template:
    * leveltext - The full level text (e.g., "AI Assessment Scale - Level 1: No AI")
    * studenttext - The instruction text for students
    * bannertype - Bootstrap alert type (info, warning, success, danger)

    Example context (json):
    {
        "leveltext": "AI Assessment Scale - Level 1: No AI",
        "studenttext": "You must not use AI at any point during the assessment.",
        "bannertype": "info"
    }
}}
<div id="local-assignmentnotice-container" class="local-assignmentnotice-container mb-3">
    <div class="alert alert-{{bannertype}}" role="alert" id="local-assignmentnotice-banner">
        <strong>{{leveltext}}</strong><br>
        <span>{{studenttext}}</span>
    </div>
</div>
{{#js}}
require(['local_assignmentnotice/banner'], function(Banner) {
    Banner.init();
});
{{/js}}
